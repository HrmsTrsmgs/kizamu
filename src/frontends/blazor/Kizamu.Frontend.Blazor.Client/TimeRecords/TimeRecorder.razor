@inject ITimeRecorderViewModel ViewModel

<div class="time-recorder">
    <section class="recorder-panel" aria-labelledby="recorder-title">
        <header class="panel-header">
            <h2 id="recorder-title">プロジェクト未指定</h2>
            <span class="status-badge @(ViewModel.IsRecording ? "is-active" : "")">
                @(ViewModel.IsRecording ? "記録中" : "待機中")
            </span>
        </header>
        <div class="recorder-action">
            @if (!ViewModel.IsRecording)
            {
                <button class="record-button" type="button" disabled="@ViewModel.IsBusy" @onclick="StartTimeRecordAsync">記録を開始</button>
            }
            else
            {
                <button class="record-button is-active" type="button" disabled="@ViewModel.IsBusy" @onclick="EndTimeRecordAsync">記録を終了</button>
            }
            @if (operationFailed)
            {
                <p role="alert">記録操作に失敗しました。</p>
            }
            @if (ViewModel.DisplayedRecord is { } displayed)
            {
                <TimeRecordTimes StartedAt="displayed.StartedAt" EndedAt="displayed.EndedAt" Labelled="true" />
            }
        </div>
    </section>
    <section class="records-panel" aria-labelledby="records-title">
        <header class="panel-header records-header">
            <h2 id="records-title">作業記録</h2>
            <span class="record-count">@(ViewModel.Records.Count)件</span>
        </header>
        <ul class="records-list" aria-label="作業記録一覧">
            @foreach (var record in ViewModel.Records)
            {
                <li @key="record.Id">
                    <span class="record-status @(record.EndedAt is null ? "is-active" : "")" aria-hidden="true"></span>
                    <TimeRecordTimes StartedAt="record.StartedAt" EndedAt="record.EndedAt" />
                </li>
            }
        </ul>
    </section>
</div>

@code {
    bool operationFailed;

    protected override Task OnInitializedAsync() => ViewModel.LoadAsync();

    async Task StartTimeRecordAsync()
    {
        try
        {
            await ViewModel.StartTimeRecordAsync();
        }
        catch
        {
            operationFailed = true;
        }
    }

    async Task EndTimeRecordAsync()
    {
        try
        {
            await ViewModel.EndTimeRecordAsync();
        }
        catch
        {
            operationFailed = true;
        }
    }
}
