@inject TimeProvider Clock
@implements IDisposable

<div class="time-record-times">
    <div class="record-time">
        <span>開始</span>
        <time aria-label="@(Labelled ? "開始時刻" : null)" datetime="@Record.StartedAt.ToHtmlDateTimeAttribute()">
            @TimeRecordTimesFormatter.FormatDateTime(Record.StartedAt)
        </time>
    </div>
    <div class="record-time">
        <span>終了</span>
        @if (Record.EndedAt is { } endedAt)
        {
            <time aria-label="@(Labelled ? "終了時刻" : null)" datetime="@endedAt.ToHtmlDateTimeAttribute()">
                @TimeRecordTimesFormatter.FormatDateTime(endedAt)
            </time>
        }
        else
        {
            <span class="recording-label">記録中</span>
        }
    </div>
    <div class="record-time">
        <span>作業時間</span>
        <span class="time-record-duration-value">@TimeRecordTimesFormatter.FormatDuration(Record.DurationAt(Record.EndedAt ?? Clock.GetUtcNow()))</span>
    </div>
</div>

@code {
    /// <summary>時刻と経過時間を表示する作業記録。</summary>
    [Parameter, EditorRequired]
    public required TimeRecord Record { get; set; }

    /// <summary>操作欄の時刻に開始時刻・終了時刻のアクセシブルな名前を付けます。</summary>
    [Parameter]
    public bool Labelled { get; set; }

    TimeRecordRefreshTimer? refreshTimer;

    protected override void OnParametersSet()
    {
        refreshTimer ??= new(Clock, () => InvokeAsync(StateHasChanged));
        refreshTimer.ScheduleRefresh(Record.EndedAt);
    }

    /// <summary>画面から取り除かれた際に、経過時間表示用のタイマーを解放します。</summary>
    public void Dispose() => refreshTimer?.Dispose();
}
