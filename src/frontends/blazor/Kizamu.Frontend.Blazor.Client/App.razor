@inject ProjectTabsViewModel ViewModel
@inject IServiceProvider Services

<main>
    <header class="app-header">
        <h1>Kizamu</h1>
        <p class="app-description">作業時間を記録します。</p>
    </header>
    <div>
        @if (!ShowAuthenticatedContent)
        {
            @if (Services.GetService(typeof(IGoogleSignIn)) is not null)
            {
                <div @ref="googleButton"></div>
            }
            else
            {
                <button type="button" @onclick="SignInAsync">Googleでログイン</button>
            }
        }
        else
        {
            <button type="button" @onclick="SignOut">ログアウト</button>
        }
    </div>
    @if (ShowAuthenticatedContent)
    {
        <section class="project-toolbar" aria-labelledby="projects-title">
            <div class="project-toolbar-heading">
                <h2 id="projects-title">プロジェクト</h2>
                <button class="project-add-button" type="button" @onclick="ViewModel.OpenProjectDialog">追加</button>
            </div>
            <div class="project-tabs" role="tablist" aria-label="プロジェクト">
                <span class="project-default" aria-selected="@(ViewModel.SelectedProject is null ? "true" : "false")">未指定</span>
                @foreach (var project in ViewModel.Projects)
                {
                    <button class="project-tab" role="tab" aria-selected="@(ViewModel.SelectedProject == project ? "true" : "false")" type="button" @onclick="() => ViewModel.SelectProject(project)">@project.Name</button>
                }
            </div>
        </section>
        <TimeRecorder SelectedProject="ViewModel.SelectedProject" AuthenticatedViewModel="timeRecorder" />
        @if (ViewModel.ShowProjectDialog)
        {
            <div class="project-dialog-overlay">
                <div class="project-dialog" role="dialog" aria-labelledby="project-dialog-title">
                    <h2 id="project-dialog-title">プロジェクトを追加</h2>
                    <label for="project-name">プロジェクト名</label>
                    <input id="project-name" @bind="ViewModel.ProjectName" />
                    <div class="project-dialog-actions">
                        <button class="project-cancel-button" type="button" @onclick="ViewModel.CancelProjectDialog">キャンセル</button>
                        <button class="project-register-button" type="button" @onclick="ViewModel.RegisterProject">登録</button>
                    </div>
                </div>
            </div>
        }
    }
    <footer class="app-footer">
        <HealthStatus />
    </footer>
</main>

@code {
    TimeRecorderViewModel? timeRecorder;
    ElementReference googleButton;
    bool renderGoogleButton = true;

    bool ShowAuthenticatedContent => IsAuthenticated || timeRecorder is not null;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (renderGoogleButton && !ShowAuthenticatedContent && Services.GetService(typeof(IGoogleSignIn)) is IGoogleSignIn google)
        {
            renderGoogleButton = false;
            await google.RenderButtonAsync(googleButton, OnCredential);
        }
    }

    void OnCredential(string token)
    {
        var create = CreateTimeRecords ?? (value => new Kizamu.Frontend.Blazor.Infrastructure.TimeRecords.TimeRecordApi(
            (HttpClient)Services.GetService(typeof(HttpClient))!, value));
        timeRecorder = new(create(token));
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Google認証を開始する操作を取得または設定します。</summary>
    [Parameter]
    public Func<Task<string>>? SignInWithGoogle { get; set; }

    /// <summary>認証トークンを使う記録サービスの生成操作を取得または設定します。</summary>
    [Parameter]
    public Func<string, ITimeRecordService>? CreateTimeRecords { get; set; }

    void SignOut()
    {
        timeRecorder = null;
        ViewModel = new();
        renderGoogleButton = true;
    }

    async Task SignInAsync()
    {
        if (SignInWithGoogle is not null && CreateTimeRecords is not null)
        {
            var token = await SignInWithGoogle();
            timeRecorder = new(CreateTimeRecords(token));
        }
    }

    /// <summary>記録画面を表示する認証済み状態を取得または設定します。</summary>
    [Parameter]
    public bool IsAuthenticated { get; set; }
}
