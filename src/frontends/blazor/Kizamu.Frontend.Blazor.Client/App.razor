@using Kizamu.Frontend.Blazor.Client.Projects
@using Kizamu.Frontend.Blazor.Infrastructure.TimeRecords
@inject ProjectTabsViewModel ViewModel
@inject IServiceProvider Services

<main>
    <header class="app-header">
        <h1>Kizamu</h1>
        <p class="app-description">作業時間を記録します。</p>
    </header>
    <div>
        @if (ShowAuthenticatedContent)
        {
            <button type="button" @onclick="SignOut">ログアウト</button>
        }
        else if (GoogleSignIn is not null)
        {
            <div @ref="googleButton"></div>
        }
        else
        {
            <button type="button" @onclick="SignInAsync">Googleでログイン</button>
        }
    </div>
    @if (ActiveTimeRecorder is { } recorder)
    {
        <ProjectTabs Projects="ViewModel.Projects"
                     SelectedProject="ViewModel.SelectedProject"
                     OnAddProject="ViewModel.Registration.Open"
                     OnSelectProject="ViewModel.SelectProject" />
        <TimeRecorder ViewModel="recorder" SelectedProject="ViewModel.SelectedProject" />
        @if (ViewModel.Registration.IsOpen)
        {
            <ProjectRegistrationDialog @bind-ProjectName="ViewModel.Registration.ProjectName"
                                       OnRegister="ViewModel.Registration.Register"
                                       OnCancel="ViewModel.Registration.Cancel" />
        }
    }
    <footer class="app-footer">
        <HealthStatus />
    </footer>
</main>

@code {
    TimeRecorderViewModel? timeRecorder;
    ElementReference googleButton;
    bool renderGoogleButton = true;
    bool hasSignedOut;

    IGoogleSignIn? GoogleSignIn => Services.GetService<IGoogleSignIn>();
    ITimeRecorderViewModel? ActiveTimeRecorder => timeRecorder ?? (hasSignedOut ? null : InitialTimeRecorder);
    bool ShowAuthenticatedContent => ActiveTimeRecorder is not null;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (renderGoogleButton && !ShowAuthenticatedContent && GoogleSignIn is { } google)
        {
            renderGoogleButton = false;
            await google.RenderButtonAsync(googleButton, OnCredential);
        }
    }

    void OnCredential(string token)
    {
        SetTimeRecorder(token, CreateTimeRecords ?? CreateAuthenticatedService);
        _ = InvokeAsync(StateHasChanged);
    }

    ITimeRecordService CreateAuthenticatedService(string token) => new TimeRecordApi(Services.GetRequiredService<HttpClient>(), token);

    /// <summary>Google認証を開始する操作を取得または設定します。</summary>
    [Parameter]
    public Func<Task<string>>? SignInWithGoogle { get; set; }

    /// <summary>認証トークンを使う記録サービスの生成操作を取得または設定します。</summary>
    [Parameter]
    public Func<string, ITimeRecordService>? CreateTimeRecords { get; set; }

    void SignOut()
    {
        hasSignedOut = true;
        timeRecorder = null;
        ViewModel = new();
        renderGoogleButton = true;
    }

    async Task SignInAsync()
    {
        if (SignInWithGoogle is not null && CreateTimeRecords is not null)
        {
            var token = await SignInWithGoogle();
            SetTimeRecorder(token, CreateTimeRecords);
        }
    }

    void SetTimeRecorder(string token, Func<string, ITimeRecordService> createTimeRecords) =>
        timeRecorder = new(createTimeRecords(token));

    /// <summary>初期表示が認証済みの場合に使用する記録ViewModelを取得または設定します。</summary>
    [Parameter]
    public ITimeRecorderViewModel? InitialTimeRecorder { get; set; }
}
