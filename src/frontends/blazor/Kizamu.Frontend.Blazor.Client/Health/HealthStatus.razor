@inject HealthStatusViewModel ViewModel

<p aria-live="polite">サーバー接続: @StatusText</p>

@code {
    string StatusText => ViewModel.IsHealthy switch
    {
        true => "正常",
        false => "失敗",
        null => "確認中",
    };

    protected override Task OnInitializedAsync() => ViewModel.CheckHealthAsync();
}
