{
  "ReverseProxy": {
    "Routes": {
      "backend": {
        "ClusterId": "backend",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "backend": {
            "Address": "http://localhost:5213"
          }
        }
      }
    }
  }
}
